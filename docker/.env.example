# Docker Compose Production & Local Environment Configuration Example
# Copy this file to .env before running docker compose.

# Production Database Credentials (REQUIRED for docker-compose.prod.yml)
POSTGRES_USER=finder
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=finder_db

# Security & Secrets (REQUIRED for docker-compose.prod.yml)
SECRET_KEY=your_strong_random_jwt_secret_key_here
OPENAI_API_KEY=your-openai-api-key-here

# CORS Configuration (REQUIRED for docker-compose.prod.yml)
# Specify allowed origin(s), e.g. http://your-domain.com or http://your-ec2-ip
CORS_ORIGINS=http://localhost:5173,http://localhost

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# pgAdmin Web Interface (Optional for docker-compose.prod.yml)
PGADMIN_DEFAULT_EMAIL=admin@finder.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=5050

